{
  "schemaVersion": 1,
  "id": "bmf-runtime",
  "componentId": "bmf-runtime",
  "name": "BMF UE4SS Lua Runtime",
  "status": "current-layout-package-boundary",
  "owner": "packages/bmf-runtime",
  "sourceRoots": [
    "framework/ue4ss/Mods/BMF"
  ],
  "installRoots": [
    "Mods/BMF"
  ],
  "entrypoints": [
    "framework/ue4ss/Mods/BMF/Scripts/main.lua"
  ],
  "requiredFiles": [
    "framework/ue4ss/Mods/BMF/bmf.json",
    "framework/ue4ss/Mods/BMF/config.json",
    "framework/ue4ss/Mods/BMF/enabled.txt",
    "framework/ue4ss/Mods/BMF/Scripts/main.lua",
    "framework/ue4ss/Mods/BMF/Scripts/bmf/runtime.lua"
  ],
  "runtimeOutputs": [
    "Mods/BMF/runtime/status.json",
    "Mods/BMF/runtime/events.jsonl",
    "Mods/BMF/runtime/audit.jsonl"
  ],
  "guardrails": [
    "keep-current-install-path",
    "validate-before-release",
    "stage-through-orchestrator-core",
    "do-not-hide-runtime-source-roots",
    "keep-omegga-template-byte-identical",
    "no-async-lua-scheduler-callbacks",
    "no-global-delayed-action-clears",
    "detect-forbidden-scheduler-aliases",
    "lua-5.3-compile-before-package"
  ]
}
