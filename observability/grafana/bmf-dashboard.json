{
  "id": null,
  "uid": "bmf-standard",
  "title": "BMF Standard Server Telemetry",
  "tags": [
    "bmf",
    "brickadia",
    "omegga"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(bmf_runtime_status_up, environment)",
        "includeAll": true,
        "multi": true,
        "refresh": 1
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(bmf_runtime_status_up{environment=~\"$environment\"}, instance)",
        "includeAll": true,
        "multi": true,
        "refresh": 1
      },
      {
        "name": "server_profile",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(bmf_runtime_status_up{environment=~\"$environment\",instance=~\"$instance\"}, server_profile)",
        "includeAll": true,
        "multi": true,
        "refresh": 1
      },
      {
        "name": "brickadia_build",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(bmf_runtime_status_up{environment=~\"$environment\",instance=~\"$instance\",server_profile=~\"$server_profile\"}, brickadia_build)",
        "includeAll": true,
        "multi": true,
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations and Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "BMF Runtime Up",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(bmf_runtime_status_up{environment=~\"$environment\",instance=~\"$instance\",server_profile=~\"$server_profile\",brickadia_build=~\"$brickadia_build\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Omegga Metrics Target",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{job=\"bmf-omegga\",environment=~\"$environment\",instance=~\"$instance\",server_profile=~\"$server_profile\"})"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "BMFSocket Connected",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(bmf_socket_connected{environment=~\"$environment\",instance=~\"$instance\",server_profile=~\"$server_profile\"})"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Frame FPS",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "fps",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 45
              },
              {
                "color": "green",
                "value": 58
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(brickadia_frame_fps{scope=\"window\",statistic=\"avg\",environment=~\"$environment\",instance=~\"$instance\",server_profile=~\"$server_profile\",brickadia_build=~\"$brickadia_build\"})"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Frame Time",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 16.67
              },
              {
                "color": "red",
                "value": 33.33
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(brickadia_frame_delta_milliseconds{scope=\"window\",statistic=\"avg\",environment=~\"$environment\",instance=~\"$instance\",server_profile=~\"$server_profile\",brickadia_build=~\"$brickadia_build\"})",
          "legendFormat": "window avg"
        },
        {
          "refId": "B",
          "expr": "max(brickadia_frame_delta_milliseconds{scope=\"window\",statistic=\"max\",environment=~\"$environment\",instance=~\"$instance\",server_profile=~\"$server_profile\",brickadia_build=~\"$brickadia_build\"})",
          "legendFormat": "window max"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Slow Frames",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (threshold_ms) (rate(brickadia_frame_slow_total{environment=~\"$environment\",instance=~\"$instance\",server_profile=~\"$server_profile\",brickadia_build=~\"$brickadia_build\"}[5m]))",
          "legendFormat": "{{threshold_ms}} ms"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Command Volume",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (command, status) (rate(bmf_command_total{environment=~\"$environment\",instance=~\"$instance\",server_profile=~\"$server_profile\"}[5m]))",
          "legendFormat": "{{command}} / {{status}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Event Volume",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event, source) (rate(bmf_event_total{environment=~\"$environment\",instance=~\"$instance\",server_profile=~\"$server_profile\"}[5m]))",
          "legendFormat": "{{event}} / {{source}}"
        }
      ]
    }
  ]
}
