{
  "name": "bmf",
  "displayName": "BMF",
  "fullName": "Brickadia Modding Framework",
  "version": "0.1.0-ea3.cl15447",
  "status": "experimental",
  "runtime": {
    "type": "UE4SS Lua",
    "entrypoint": "framework/ue4ss/Mods/BMF/Scripts/main.lua",
    "implementation": "framework/ue4ss/Mods/BMF/Scripts/bmf/runtime.lua",
    "optionalNativeTransport": {
      "type": "UE4SS C++",
      "mod": "BMFSocket",
      "entrypoint": "framework/ue4ss/Mods/BMFSocket/dlls/main.dll",
      "source": "native/bmf_socket",
      "buildScript": "scripts/build-bmf-socket-native-mod.ps1"
    },
    "optionalNativeFrameTelemetry": {
      "type": "UE4SS C++",
      "mod": "BMFFrameTelemetry",
      "entrypoint": "framework/ue4ss/Mods/BMFFrameTelemetry/dlls/main.dll",
      "source": "native/bmf_frame_telemetry",
      "buildScript": "scripts/build-bmf-frame-telemetry-native-mod.ps1",
      "output": "framework/ue4ss/Mods/BMF/runtime/frame-telemetry.json"
    }
  },
  "runtimeStrategy": {
    "standalone": false,
    "requiresOmegga": true,
    "requiresBmfCompatibleOmegga": true,
    "dependenciesManifest": "manifests/dependencies.json",
    "supportedAdapters": [
      "packages/omegga-plugins/bmf-player-sync",
      "packages/omegga-plugins/bmf-minigame-events"
    ],
    "notes": "BMF currently targets a BMF-compatible Omegga runtime for Windows launch, UE4SS setup, command transport, player sync, minigame event feeding, helper globals, logs, and validation. Upstream Omegga alone may not satisfy these requirements until the BMF compatibility work is included."
  },
  "supportedPlatforms": [
    "windows-dedicated-server"
  ],
  "supportedBrickadiaBuilds": [
    {
      "build": "PC-Shipping-CL15447",
      "status": "staged",
      "notes": "Current reverse-engineering target. Core UE4SS startup, BMF initialization, and Omegga metrics have local live evidence; native BMF modules, the dumper, and player-dependent surfaces remain pending CL15447 remapping and validation."
    }
  ],
  "capabilities": [
